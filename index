function pXY(e,t){const w=document.getElementById('pw'+Cap(t));const r=w.getBoundingClientRect();const tc=e.touches?e.touches[0]:e;return{x:Math.max(0,Math.min(r.width,tc.clientX-r.left)),y:Math.max(0,Math.min(r.height,tc.clientY-r.top)),w:r.width,h:r.height}}

function pickAt(x,y,w,h,t){
  const c=document.getElementById('pc'+Cap(t));if(!c.width)return null;
  const ctx=c.getContext('2d',{willReadFrequently:true});
  const img=document.getElementById('pImg'+Cap(t));
  const nw=img.naturalWidth,nh=img.naturalHeight;
  const sc=Math.min(w/nw,h/nh),dw=nw*sc,dh=nh*sc,ox=(w-dw)/2,oy=(h-dh)/2;
  const cx=Math.round((x-ox)/sc),cy=Math.round((y-oy)/sc);
  if(cx<0||cy<0||cx>=nw||cy>=nh)return null;
  let rT=0,gT=0,bT=0,n=0;
  for(let dx=-1;dx<=1;dx++)for(let dy=-1;dy<=1;dy++){
    const px=Math.max(0,Math.min(nw-1,cx+dx)),py=Math.max(0,Math.min(nh-1,cy+dy));
    const d=ctx.getImageData(px,py,1,1).data;rT+=d[0];gT+=d[1];bT+=d[2];n++;
  }
  const r=Math.round(rT/n),g=Math.round(gT/n),b=Math.round(bT/n);
  const lab=rgb2lab(r,g,b),hsl=rgb2hsl(r,g,b),cmyk=rgb2cmyk(r,g,b),hex=rgb2hex(r,g,b);
  document.getElementById('mk'+Cap(t)).style.display='block';
  document.getElementById('mk'+Cap(t)).style.left=x+'px';
  document.getElementById('mk'+Cap(t)).style.top=y+'px';
  document.getElementById('rd'+Cap(t)).classList.add('visible');
  document.getElementById('sw'+Cap(t)).style.background=`rgb(${r},${g},${b})`;
  document.getElementById('hx'+Cap(t)).textContent=hex;
  document.getElementById('rv'+Cap(t)).textContent=`${r}, ${g}, ${b}`;
  document.getElementById('lv'+Cap(t)).textContent=lab.map(v=>v.toFixed(1)).join(', ');
  document.getElementById('hv'+Cap(t)).textContent=`${hsl[0]}° ${hsl[1]}% ${hsl[2]}%`;
  document.getElementById('cv'+Cap(t)).textContent=cmyk.map(v=>v+'%').join(' ');
  S['p'+Cap(t)+'Lab']=lab;S['p'+Cap(t)+'RGB']=[r,g,b];
  checkPt();
  return{cx,cy};
}
function showLoupe(x,y,t,cx,cy){
  const lp=document.getElementById('lp'+Cap(t)),c=document.getElementById('pc'+Cap(t));
  if(!c.width){lp.style.display='none';return}
  const lc=document.getElementById('lc'+Cap(t)),lx=lc.getContext('2d');
  lp.style.display='block';lp.style.left=Math.max(0,x-40)+'px';lp.style.top=Math.max(0,y-100)+'px';
  lx.imageSmoothingEnabled=false;lx.clearRect(0,0,80,80);
  const z=6,sw=80/z;
  lx.drawImage(c,cx-sw/2,cy-sw/2,sw,sw,0,0,80,80);
  lx.strokeStyle='rgba(255,255,255,0.5)';lx.lineWidth=1;
  lx.beginPath();lx.moveTo(40,0);lx.lineTo(40,80);lx.stroke();
  lx.beginPath();lx.moveTo(0,40);lx.lineTo(80,40);lx.stroke();
}
