<script>
// ===== STATE (in-memory, no localStorage) =====
const S = {
  stdImg:null, smpImg:null, roi:'full',
  logs:[], lastR:null,
  pStdImg:null, pSmpImg:null, pStdLab:null, pSmpLab:null, pStdRGB:null, pSmpRGB:null
};

// Load logs from persistent storage
function loadLogs() {
  try {
    const raw = localStorage.getItem('qc_logs');
    if (raw) S.logs = JSON.parse(raw);
  } catch(e) { S.logs = []; }
  renderLogs();
}
function saveLogs() {
  try {
    if (S.logs.length > 500) S.logs = S.logs.slice(0, 500);
    localStorage.setItem('qc_logs', JSON.stringify(S.logs));
  } catch(e) { console.warn('Storage full or unavailable'); }
}
loadLogs();

// ===== SETTINGS PERSISTENCE =====
function loadSettings() {
  try {
    const raw = localStorage.getItem('qc_settings');
    if (raw) {
      const s = JSON.parse(raw);
      if (s.thPass !== undefined) document.getElementById('thPass').value = s.thPass;
      if (s.thWarn !== undefined) document.getElementById('thWarn').value = s.thWarn;
      if (s.product !== undefined) document.getElementById('fieldProduct').value = s.product;
      if (s.lot !== undefined) document.getElementById('fieldLot').value = s.lot;
      if (s.supplier !== undefined) document.getElementById('fieldSupplier').value = s.supplier;
      if (s.inspector !== undefined) document.getElementById('fieldInspector').value = s.inspector;
    }
  } catch(e) {}
  updateSessionBadge();
}
function saveSettings() {
  try {
    const s = {
      thPass: document.getElementById('thPass').value,
      thWarn: document.getElementById('thWarn').value,
      product: document.getElementById('fieldProduct').value,
      lot: document.getElementById('fieldLot').value,
      supplier: document.getElementById('fieldSupplier').value,
      inspector: document.getElementById('fieldInspector').value
    };
    localStorage.setItem('qc_settings', JSON.stringify(s));
  } catch(e) {}
  updateSessionBadge();
}
function updateSessionBadge() {
  const p = document.getElementById('fieldProduct').value.trim();
  const l = document.getElementById('fieldLot').value.trim();
  const badge = document.getElementById('sessionBadge');
  if(p || l) {
    badge.textContent = (p || '—') + ' | ' + (l || '—');
    badge.style.background = 'rgba(16,185,129,0.15)';
    badge.style.color = 'var(--accent-green)';
    badge.style.borderColor = 'rgba(16,185,129,0.3)';
  } else {
    badge.textContent = 'ยังไม่กำหนด';
    badge.style.background = 'rgba(6,182,212,0.15)';
    badge.style.color = 'var(--accent-cyan)';
    badge.style.borderColor = 'rgba(6,182,212,0.3)';
  }
}

loadSettings();

// ===== TABS / MODES =====
function updateStorageInfo() {
  try {
    const logRaw = localStorage.getItem('qc_logs') || '[]';
    const logCount = JSON.parse(logRaw).length;
    const totalBytes = Object.keys(localStorage).reduce((sum,k) => sum + (localStorage.getItem(k)||'').length * 2, 0);
    const kb = (totalBytes / 1024).toFixed(1);
    const el1 = document.getElementById('storageInfo');
    const el2 = document.getElementById('storageSize');
    if (el1) el1.textContent = logCount + ' records';
    if (el2) el2.textContent = kb + ' KB / ~5 MB';
  } catch(e) {}
}
function switchTab(t) {
  document.querySelectorAll('.tab-content').forEach(e=>e.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById('tab-'+t).classList.add('active');
  document.querySelectorAll('.nav-btn')[{compare:0,history:1,settings:2}[t]].classList.add('active');
  if(t==='history') renderLogs();
  if(t==='settings') updateStorageInfo();
}
function switchMode(m) {
  document.querySelectorAll('.mode-btn').forEach(b=>b.classList.remove('active'));
  document.querySelectorAll('.mode-panel').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.mode-btn')[m==='area'?0:1].classList.add('active');
  document.getElementById('mode-'+m).classList.add('active');
}

// ===== COLOR SCIENCE =====
const s2l=c=>{c/=255;return c<=0.04045?c/12.92:Math.pow((c+0.055)/1.055,2.4)};
function rgb2xyz(r,g,b){const lr=s2l(r),lg=s2l(g),lb=s2l(b);return[lr*.4124564+lg*.3575761+lb*.1804375,lr*.2126729+lg*.7151522+lb*.0721750,lr*.0193339+lg*.1191920+lb*.9503041]}
function xyz2lab(x,y,z){const f=t=>t>.008856?Math.cbrt(t):7.787*t+16/116;return[116*f(y/1)-16,500*(f(x/.95047)-f(y/1)),200*(f(y/1)-f(z/1.08883))]}
function rgb2lab(r,g,b){return xyz2lab(...rgb2xyz(r,g,b))}
function dE76(a,b){return Math.sqrt((a[0]-b[0])**2+(a[1]-b[1])**2+(a[2]-b[2])**2)}
function rgb2hsl(r,g,b){r/=255;g/=255;b/=255;const mx=Math.max(r,g,b),mn=Math.min(r,g,b),d=mx-mn;let h=0,s=0,l=(mx+mn)/2;if(d){s=l>.5?d/(2-mx-mn):d/(mx+mn);if(mx===r)h=((g-b)/d+(g<b?6:0))/6;else if(mx===g)h=((b-r)/d+2)/6;else h=((r-g)/d+4)/6}return[Math.round(h*360),Math.round(s*100),Math.round(l*100)]}
function rgb2cmyk(r,g,b){if(!r&&!g&&!b)return[0,0,0,100];const c=1-r/255,m=1-g/255,y=1-b/255,k=Math.min(c,m,y);return[Math.round((c-k)/(1-k)*100),Math.round((m-k)/(1-k)*100),Math.round((y-k)/(1-k)*100),Math.round(k*100)]}
function rgb2hex(r,g,b){return'#'+[r,g,b].map(v=>v.toString(16).padStart(2,'0')).join('').toUpperCase()}

function roiB(w,h){if(S.roi==='center50'){const rw=w*.5,rh=h*.5;return[~~((w-rw)/2),~~((h-rh)/2),~~rw,~~rh]}if(S.roi==='center25'){const rw=w*.25,rh=h*.25;return[~~((w-rw)/2),~~((h-rh)/2),~~rw,~~rh]}return[0,0,w,h]}
function avgLab(c,x){const[rx,ry,rw,rh]=roiB(c.width,c.height);const d=x.getImageData(rx,ry,rw,rh).data;let tL=0,tA=0,tB=0,n=0;const st=d.length>400000?16:4;for(let i=0;i<d.length;i+=st){const[l,a,b]=rgb2lab(d[i],d[i+1],d[i+2]);tL+=l;tA+=a;tB+=b;n++}return[tL/n,tA/n,tB/n]}
function avgRGB(c,x){const[rx,ry,rw,rh]=roiB(c.width,c.height);const d=x.getImageData(rx,ry,rw,rh).data;let r=0,g=0,b=0,n=0;const st=d.length>400000?16:4;for(let i=0;i<d.length;i+=st){r+=d[i];g+=d[i+1];b+=d[i+2];n++}return[Math.round(r/n),Math.round(g/n),Math.round(b/n)]}
function hCorr(x1,w1,h1,x2,w2,h2){function bh(x,w,h){const[rx,ry,rw,rh]=roiB(w,h);const d=x.getImageData(rx,ry,rw,rh).data;const bi=32,hR=new Float64Array(bi),hG=new Float64Array(bi),hB=new Float64Array(bi);let n=0;const st=d.length>400000?16:4;for(let i=0;i<d.length;i+=st){hR[~~(d[i]/8)]++;hG[~~(d[i+1]/8)]++;hB[~~(d[i+2]/8)]++;n++}for(let j=0;j<bi;j++){hR[j]/=n;hG[j]/=n;hB[j]/=n}return{r:hR,g:hG,b:hB}}function cr(a,b){let s=0,a2=0,b2=0;const ma=a.reduce((s,v)=>s+v,0)/a.length,mb=b.reduce((s,v)=>s+v,0)/b.length;for(let i=0;i<a.length;i++){const da=a[i]-ma,db=b[i]-mb;s+=da*db;a2+=da*da;b2+=db*db}const dn=Math.sqrt(a2*b2);return dn?s/dn:0}const h1d=bh(x1,w1,h1),h2d=bh(x2,w2,h2);return(cr(h1d.r,h2d.r)+cr(h1d.g,h2d.g)+cr(h1d.b,h2d.b))/3*100}

